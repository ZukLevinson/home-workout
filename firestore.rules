rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// This security rules file enforces strict per-user data isolation
// (Anonymous Auth + Google Sign-In) and assumes the following schemas:
//
// 1. Collection: /users/{userId}/state/{docId}
//    Document ID: 'activeDraft' (only this singleton document ID is permitted)
//    Access: Owner only (request.auth.uid == userId) for read (get), create, update, delete
//    Fields (all required, no extraneous fields allowed):
//      - draftJson: string (required, mutable, length 2..25000) - serialized active workout draft
//      - updatedAtMs: number (required, mutable, > 0 and <= 99999999999999) - last updated epoch ms
//
// 2. Collection: /users/{userId}/workouts/{workoutId}
//    Document ID: {workoutId} (string, length 1..80, must match data.id)
//    Access: Owner only (request.auth.uid == userId) for read (get, list), create, update, delete
//    Fields (all 9 required, no extraneous fields allowed):
//      - id: string (required, immutable on update, equals workoutId, length 1..80) - workout ID
//      - isoDate: string (required, mutable, length 10..40) - ISO date/datetime string
//      - createdAtMs: number (required, immutable on update, > 0 and <= 99999999999999) - created epoch ms
//      - displayDate: string (required, mutable, length 1..120) - formatted display date
//      - workoutTab: string (required, mutable, enum: 'workoutA' | 'workoutB' | 'express' | 'all' | 'imported')
//      - workoutTitle: string (required, mutable, length 1..150) - workout title
//      - note: string (required, mutable, length 0..500) - user session note
//      - totalSets: int (required, mutable, range 1..150) - total completed sets
//      - items: list (required, mutable, size 1..30) - completed exercise entries
//
// All other paths, collections, and documents are denied by default.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Verify that the request comes from a signed-in user (Anonymous or Google)
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verify that the signed-in user owns the user-scoped path
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verify any optional uid field has not been spoofed on create
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    // Verify any optional uid field is not modified on update
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // Verify all required fields are present in the resulting document
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Verify no unexpected/extraneous fields exist in the resulting document
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Verify exact schema key match (all required keys present and no others)
    function hasExactFields(fields) {
      return hasRequiredFields(fields) && hasOnlyAllowedFields(fields);
    }

    // Validate string type and character length bounds
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // Validate positive epoch millisecond number (int or float) with sane upper bound
    function isPositiveTimestampMs(field) {
      return request.resource.data[field] is number &&
        request.resource.data[field] > 0 &&
        request.resource.data[field] <= 99999999999999;
    }

    // Validate integer within inclusive bounds
    function isValidIntRange(field, minVal, maxVal) {
      return request.resource.data[field] is int &&
        request.resource.data[field] >= minVal &&
        request.resource.data[field] <= maxVal;
    }

    // Validate list type and item count bounds
    function isValidListRange(listVal, minSize, maxSize) {
      return listVal is list &&
        listVal.size() >= minSize &&
        listVal.size() <= maxSize;
    }

    // Ensure specified fields have not been modified during an update
    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ===============================================================
    // Domain Validators (Called on BOTH create and update)
    // ===============================================================

    function isValidActiveDraft(data, docId) {
      let allowedFields = ['draftJson', 'updatedAtMs'];
      return docId == 'activeDraft' &&
        hasExactFields(allowedFields) &&
        validStringLength('draftJson', 2, 25000) &&
        isPositiveTimestampMs('updatedAtMs') &&
        data.draftJson is string &&
        data.updatedAtMs is number;
    }

    function isValidWorkout(data, workoutId) {
      let allowedFields = [
        'id',
        'isoDate',
        'createdAtMs',
        'displayDate',
        'workoutTab',
        'workoutTitle',
        'note',
        'totalSets',
        'items'
      ];
      let allowedTabs = [
        'workoutA',
        'workoutB',
        'express',
        'all',
        'imported'
      ];
      return workoutId.size() >= 1 &&
        workoutId.size() <= 80 &&
        hasExactFields(allowedFields) &&
        validStringLength('id', 1, 80) &&
        data.id == workoutId &&
        validStringLength('isoDate', 10, 40) &&
        isPositiveTimestampMs('createdAtMs') &&
        validStringLength('displayDate', 1, 120) &&
        data.workoutTab is string &&
        data.workoutTab in allowedTabs &&
        validStringLength('workoutTitle', 1, 150) &&
        validStringLength('note', 0, 500) &&
        isValidIntRange('totalSets', 1, 150) &&
        isValidListRange(data.items, 1, 30);
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /users/{userId} {
      // Root user document itself is unused and locked down
      allow read, write: if false;

      // Active workout draft state (/users/{userId}/state/activeDraft)
      match /state/{docId} {
        allow read: if isOwner(userId) && docId == 'activeDraft';
        allow create: if isOwner(userId) &&
          uidUnchanged() &&
          isValidActiveDraft(request.resource.data, docId);
        allow update: if isOwner(userId) &&
          uidNotModified() &&
          isValidActiveDraft(request.resource.data, docId);
        allow delete: if isOwner(userId) && docId == 'activeDraft';
      }

      // Completed & imported workout logs (/users/{userId}/workouts/{workoutId})
      match /workouts/{workoutId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) &&
          uidUnchanged() &&
          isValidWorkout(request.resource.data, workoutId);
        allow update: if isOwner(userId) &&
          uidNotModified() &&
          isValidWorkout(request.resource.data, workoutId) &&
          areImmutableFieldsUnchanged(['id', 'createdAtMs']) &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.createdAtMs == resource.data.createdAtMs;
        allow delete: if isOwner(userId);
      }
    }

    // Default deny-all fallback for every other collection and path
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
